<launch>
  <!-- follow_test: 基础视觉巡线 + 角点停车，不包含原 follow_end 的环岛/雷达复杂流程。 -->

  <!--
    ======================== 快速调参入口 ========================
    所有 <arg> 都可以在 roslaunch 命令行用 “参数名:=值” 临时覆盖，不必修改本文件。

    示例：低速测试 YRight，并把横线搜索最大里程改为 0.50 m：
      roslaunch flow_end follow_test.launch \
        base_speed:=0.20 y_approach_speed:=0.12 \
        y_crossbar_seek_max_odom:=0.50 y_turn_angular_speed:=0.25

    最关键的实车参数：
      普通巡线：base_speed、aim_distance
      Y 中线接近：y_approach_speed、y_entry_min_odom、y_entry_max_odom
      横线触发：y_crossbar_target_long_m、y_crossbar_long_tolerance_m、
                y_crossbar_confirm_frames、y_crossbar_seek_max_odom
      Y 转向：y_turn_angle_deg、y_turn_angular_speed、y_turn_pause_sec
      停车：parking_extra_dist、parking_forward_speed、parking_motion_mode、parking_max_angular_speed
      普通丢线：lost_corner_search_timeout、lost_corner_search_angular_speed

    安全原则：先降低速度，再逐步增加里程或角度；不要把 *_max_odom 设置为 0，
    因为 moved >= 0 会立即满足里程兜底条件。
    ==============================================================
  -->

  <!-- 输入图像话题。根据实际相机修改，例如 /ucar_image/image_raw 或 /ucar_camera/image_raw。 -->
  <arg name="image_topic" default="/ucar_camera/image_raw" />

  <!-- IMU 话题，用于读取 yaw，初始转角逻辑依赖它判断已经转过的角度。 -->
  <arg name="imu_topic" default="/imu" />

  <!-- 里程计话题，目前只记录位移，基础巡线控制主要不依赖它。 -->
  <arg name="odom_topic" default="/odom" />

  <!-- 底盘速度控制输出话题。 -->
  <arg name="cmd_vel_topic" default="/cmd_vel" />

  <!-- 启动/切换指令话题。发送 Left / Middle / Right / Stop。 -->
  <arg name="begin_topic" default="/follow_begin" />
  <arg name="image_queue_size" default="1" />
  <arg name="imu_queue_size" default="10" />
  <arg name="odom_queue_size" default="10" />
  <arg name="begin_queue_size" default="10" />

  <!-- 巡线完成或停车后发布结束消息的话题。 -->
  <arg name="end_topic" default="/follow_end" />
  <arg name="status_topic" default="/flow_end/follow_test_status" />
  <arg name="debug_topic" default="/flow_end/follow_test_debug" />

  <!-- 默认路径选择：left / middle / right。Y 岔路请通过 begin_topic 发送 YLeft/YRight。 -->
  <arg name="path_select" default="right" />

  <!--
    路径像素偏置，单位 px。用于把生成的目标路径向一侧平移。
    数值绝对值越大，车辆贴线偏移越明显；左右符号沿用当前算法约定，调节时每次建议 2～5 px。
  -->
  <arg name="default_dis_bias_left" default="0.0" />
  <arg name="default_dis_bias_right" default="0.0" />
  <arg name="left_dis_bias_left" default="6.0" />
  <arg name="left_dis_bias_right" default="0.0" />
  <arg name="right_dis_bias_left" default="12.0" />
  <arg name="right_dis_bias_right" default="-35.0" />
  <arg name="middle_dis_bias_left" default="0.0" />
  <arg name="middle_dis_bias_right" default="0.0" />
  <arg name="time_local" default="0.5" />
  <arg name="left_time_local" default="0.5" />
  <arg name="right_time_local" default="0.5" />
  <arg name="middle_time_local" default="0.5" />

  <!-- ======================== L 角停车参数 ======================== -->
  <!-- 是否启用 L 型角点停车。调试岔路但不希望自动停车时可设为 false。 -->
  <arg name="parking_enabled" default="true" />

  <!--
    是否允许使用另一侧 L 点停车：
      true：Left 可接受 Right_L、Right 可接受 Left_L，容错强但可能掩盖目标侧丢线；
      false：只接受目标侧 L 点，适合验证分支选择是否正确。
  -->
  <arg name="parking_allow_either_l" default="true" />

  <!-- 【关键】检测到停车角点后额外前进距离，单位 m；增大则停车位置更靠前。建议每次调整 0.02～0.05 m。 -->
  <arg name="parking_extra_dist" default="0.315" />

  <!-- 【关键】停车接近阶段前进速度，单位 m/s；实车初调建议 0.10～0.15。 -->
  <arg name="parking_forward_speed" default="0.15" />

  <!-- lateral 模式使用横移速度；两种模式都使用横向死区与底盘方向符号。 -->
  <arg name="parking_lateral_speed" default="0.10" />
  <arg name="parking_lateral_deadband" default="0.03" />
  <arg name="parking_lateral_cmd_sign" default="1.0" />

  <!-- 默认以两段对称圆弧完成横向修正；设为 lateral 可回退到旧的直接横移。 -->
  <arg name="parking_motion_mode" default="s_curve" />
  <arg name="parking_max_angular_speed" default="0.35" />
  <arg name="parking_yaw_kp" default="1.5" />
  <arg name="parking_yaw_tolerance_deg" default="3.0" />
  <arg name="parking_timeout" default="6.0" />
  <arg name="parking_odom_timeout" default="0.5" />

  <!-- 是否发布调试图像 /flow_end/follow_test_debug，可用 rqt_image_view 查看。 -->
  <arg name="publish_debug_image" default="true" />

  <!-- 是否弹出 OpenCV 本地窗口；远程 SSH/无桌面环境建议保持 false。 -->
  <arg name="show_window" default="false" />

  <!-- 视频保存相关参数 -->
  <!-- 是否启用视频保存（启用后将替代ROS话题发布，直接保存为AVI文件） -->
  <arg name="enable_video_record" default="true" />

  <!-- 视频帧率，建议10-15 FPS，过高会增加CPU和磁盘压力 -->
  <arg name="video_fps" default="10" />

  <!-- 视频保存路径（留空则使用默认路径 /tmp/follow_test_debug_时间戳.avi） -->
  <arg name="video_save_path" default="" />

  <!-- ======================== 普通巡线参数 ======================== -->
  <!-- 【关键】正常巡线基础前进速度，单位 m/s；转弯误差增大时程序会自动降速。 -->
  <arg name="base_speed" default="0.30" />

  <!-- 【关键】前视距离，单位 m。增大更平稳但转弯响应变慢；减小更灵敏但容易摆动。 -->
  <arg name="aim_distance" default="0.08" />

  <!-- 控制点纵向偏置，单位 m；会参与 dy 计算，通常保持标定值，不作为首选调参项。 -->
  <arg name="aim_y_bias_m" default="0.20" />

  <!-- 最低转角控制量，用于普通起步预转阶段。 -->
  <arg name="min_pid_speed" default="0.15" />

  <!-- ======================== Y 型岔路参数 ======================== -->
  <!-- 历史兼容参数；当前 Y 状态机主要依据里程参数 y_entry_min/max_odom。 -->
  <arg name="y_approach_dist" default="0.20" />

  <!-- 【关键】YLeft/YRight 原地转向目标角度，单位 deg。增大则转得更深；建议从 45° 小步调整。 -->
  <arg name="y_turn_angle_deg" default="45.0" />

  <!-- 【关键】Y 转向角速度上限，单位 rad/s。降低更稳但耗时更长，实车初调建议 0.20～0.35。 -->
  <arg name="y_turn_angular_speed" default="0.35" />

  <!-- Y 转向完成后的零速暂停时间，单位 s；用于等待底盘停稳和图像稳定。 -->
  <arg name="y_turn_pause_sec" default="0.5" />

  <!-- 历史 Y 点索引过滤范围；当前算法日志显示 id_filter=off 时不参与判断。 -->
  <arg name="y_detect_min_id" default="0" />

  <!-- 【关键】Y 中线接近的前视距离，单位 m；增大更平滑，减小转向响应更快。 -->
  <arg name="y_center_aim_dist" default="0.45" />

  <!-- 【关键】检测到 Y 点后的中线接近速度，单位 m/s；建议低于普通 base_speed。 -->
  <arg name="y_approach_speed" default="0.18" />

  <!-- 中线接近阶段最大纠偏角速度，单位 rad/s，防止入口处大幅摆动。 -->
  <arg name="y_center_max_wz" default="0.25" />

  <!-- 中线接近阶段全部线连续丢失多少帧后允许转向；增大可抗抖，但会更晚转向。 -->
  <arg name="y_lost_confirm_frames" default="3" />

  <!-- 【关键】进入 Y_CENTER_APPROACH 后至少前进该距离，才允许按“丢线”触发转向。单位 m。 -->
  <arg name="y_entry_min_odom" default="0.08" />

  <!-- 【关键】中线接近最大里程兜底，单位 m；达到后即使仍有线也会进入 Y 转向。 -->
  <arg name="y_entry_max_odom" default="0.60" />

  <arg name="y_detect_max_id" default="100" />

  <!-- Y 点连续确认帧数；2 较灵敏，3 更抗误检。 -->
  <arg name="y_detect_confirm_frames" default="2" />

  <!-- ======================== 前方横线搜索参数 ======================== -->
  <!-- 横线搜索阶段直行速度，单位 m/s；建议保持低速 0.05～0.10。 -->
  <arg name="y_crossbar_seek_speed" default="0.08" />

  <!-- 在 Y_SEARCH 中全部线连续丢失多少帧后进入横线搜索。 -->
  <arg name="y_crossbar_lost_confirm_frames" default="3" />

  <!-- 【关键】横线触发的目标前向距离，单位 m；增大表示更早转向。 -->
  <arg name="y_crossbar_target_long_m" default="0.25" />

  <!-- 【关键】目标前向距离允许误差，单位 m；当前有效区间为 target ± tolerance。 -->
  <arg name="y_crossbar_long_tolerance_m" default="0.10" />

  <!-- 横线中心允许的最大横向偏差，单位 m；减小更严格，过小可能一直无法确认。 -->
  <arg name="y_crossbar_max_abs_lat_m" default="0.18" />

  <!-- 横线距离和横向条件连续满足的帧数；2 响应快，3 更抗单帧误检。 -->
  <arg name="y_crossbar_confirm_frames" default="2" />

  <!--
    【关键】横线搜索最大里程兜底，单位 m。
    达到后会以 reason=max_odom 强制进入 Y 转向；增大可以多找一段，但会更深入岔路。
    0.08 m/s 下每增加 0.10 m，理论上会多搜索约 1.25 s。
  -->
  <arg name="y_crossbar_seek_max_odom" default="0.75" />

  <!-- ======================== 中线接近控制器参数 ======================== -->
  <!-- 以下 control_* 只用于接入 follow_motion_controller 的特殊阶段；普通巡线仍使用当前控制。 -->
  <arg name="control_path_smooth_window" default="2" />
  <arg name="control_path_ema_alpha" default="0.35" />
  <arg name="control_error_filter_alpha" default="0.65" />
  <arg name="control_yaw_deadband" default="0.015" />
  <arg name="control_kp_yaw" default="1.00" />
  <arg name="control_ki_yaw" default="0.00" />
  <arg name="control_kd_yaw" default="0.08" />
  <arg name="control_integral_limit" default="0.30" />
  <arg name="control_integral_error_threshold" default="0.25" />
  <arg name="control_adaptive_error_threshold" default="0.35" />
  <arg name="control_adaptive_kp_scale" default="1.25" />
  <arg name="control_adaptive_kd_scale" default="1.40" />
  <arg name="control_max_wz" default="0.65" />
  <arg name="control_soft_wz_limit" default="0.55" />
  <arg name="control_max_wz_rate" default="1.80" />
  <arg name="control_turn_slowdown" default="0.65" />
  <arg name="control_slow_error" default="0.45" />
  <arg name="control_min_speed" default="0.05" />
  <arg name="control_degraded_speed_scale" default="0.75" />
  <arg name="control_max_accel" default="0.35" />
  <arg name="control_max_decel" default="0.80" />
  <arg name="control_cmd_filter_alpha" default="0.45" />
  <arg name="lost_line_coast_sec" default="0.15" />
  <arg name="lost_line_coast_speed_scale" default="0.60" />

  <!-- 普通 Left/Right 巡线的角点丢线搜索；Y 岔路阶段由 Y 状态机单独接管，不使用这套补偿转角。 -->
  <arg name="lost_corner_search_enabled" default="true" />
  <arg name="lost_corner_search_timeout" default="0.6" />
  <arg name="lost_corner_search_angular_speed" default="0.25" />
  <arg name="lost_corner_search_linear_speed" default="0.0" />

  <!-- 是否启用起步预转角。Left/Right 会先原地转向目标岔路，Middle 不预转。 -->
  <arg name="initial_turn_enabled" default="true" />

  <!-- 起步预转最大角度，单位：度。达到该角度后停止预转。 -->
  <arg name="initial_turn_angle_deg" default="60" />

  <!-- 起步预转角速度，单位：rad/s。Left 为正，Right 为负。 -->
  <arg name="initial_turn_angular_speed" default="0.35" />

  <!-- 目标线点数阈值。预转过程中如果目标线点数达到该值，会提前结束预转。 -->
  <arg name="initial_turn_rpts_threshold" default="500" />

  <!-- 预转结束后的停顿时间，单位：秒。停顿期间持续发布零速度，再进入正常巡线。 -->
  <arg name="initial_turn_pause_sec" default="0.65" />

  <node pkg="flow_end" type="follow_test" name="follow_test" output="screen">
    <param name="image_topic" value="$(arg image_topic)" />
    <param name="imu_topic" value="$(arg imu_topic)" />
    <param name="odom_topic" value="$(arg odom_topic)" />
    <param name="cmd_vel_topic" value="$(arg cmd_vel_topic)" />
    <param name="begin_topic" value="$(arg begin_topic)" />
    <param name="image_queue_size" value="$(arg image_queue_size)" />
    <param name="imu_queue_size" value="$(arg imu_queue_size)" />
    <param name="odom_queue_size" value="$(arg odom_queue_size)" />
    <param name="begin_queue_size" value="$(arg begin_queue_size)" />
    <param name="end_topic" value="$(arg end_topic)" />
    <param name="status_topic" value="$(arg status_topic)" />
    <param name="debug_topic" value="$(arg debug_topic)" />
    <param name="path_select" value="$(arg path_select)" />
    <param name="default_dis_bias_left" value="$(arg default_dis_bias_left)" />
    <param name="default_dis_bias_right" value="$(arg default_dis_bias_right)" />
    <param name="left_dis_bias_left" value="$(arg left_dis_bias_left)" />
    <param name="left_dis_bias_right" value="$(arg left_dis_bias_right)" />
    <param name="right_dis_bias_left" value="$(arg right_dis_bias_left)" />
    <param name="right_dis_bias_right" value="$(arg right_dis_bias_right)" />
    <param name="middle_dis_bias_left" value="$(arg middle_dis_bias_left)" />
    <param name="middle_dis_bias_right" value="$(arg middle_dis_bias_right)" />
    <param name="time_local" value="$(arg time_local)" />
    <param name="left_time_local" value="$(arg left_time_local)" />
    <param name="right_time_local" value="$(arg right_time_local)" />
    <param name="middle_time_local" value="$(arg middle_time_local)" />
    <param name="parking_enabled" value="$(arg parking_enabled)" />
    <param name="parking_allow_either_l" value="$(arg parking_allow_either_l)" />
    <param name="parking_extra_dist" value="$(arg parking_extra_dist)" />
    <param name="parking_forward_speed" value="$(arg parking_forward_speed)" />
    <param name="parking_lateral_speed" value="$(arg parking_lateral_speed)" />
    <param name="parking_lateral_deadband" value="$(arg parking_lateral_deadband)" />
    <param name="parking_lateral_cmd_sign" value="$(arg parking_lateral_cmd_sign)" />
    <param name="parking_motion_mode" value="$(arg parking_motion_mode)" />
    <param name="parking_max_angular_speed" value="$(arg parking_max_angular_speed)" />
    <param name="parking_yaw_kp" value="$(arg parking_yaw_kp)" />
    <param name="parking_yaw_tolerance_deg" value="$(arg parking_yaw_tolerance_deg)" />
    <param name="parking_timeout" value="$(arg parking_timeout)" />
    <param name="parking_odom_timeout" value="$(arg parking_odom_timeout)" />
    <param name="publish_debug_image" value="$(arg publish_debug_image)" />
    <param name="show_window" value="$(arg show_window)" />
    <param name="enable_video_record" value="$(arg enable_video_record)" />
    <param name="video_fps" value="$(arg video_fps)" />
    <param name="video_save_path" value="$(arg video_save_path)" />
    <param name="base_speed" value="$(arg base_speed)" />
    <param name="aim_distance" value="$(arg aim_distance)" />
    <param name="aim_y_bias_m" value="$(arg aim_y_bias_m)" />
    <param name="initial_turn_enabled" value="$(arg initial_turn_enabled)" />
    <param name="initial_turn_angle_deg" value="$(arg initial_turn_angle_deg)" />
    <param name="initial_turn_angular_speed" value="$(arg initial_turn_angular_speed)" />
    <param name="initial_turn_rpts_threshold" value="$(arg initial_turn_rpts_threshold)" />
    <param name="initial_turn_pause_sec" value="$(arg initial_turn_pause_sec)" />
    <param name="min_pid_speed" value="$(arg min_pid_speed)" />
    <param name="y_approach_dist" value="$(arg y_approach_dist)" />
    <param name="y_turn_angle_deg" value="$(arg y_turn_angle_deg)" />
    <param name="y_turn_angular_speed" value="$(arg y_turn_angular_speed)" />
    <param name="y_turn_pause_sec" value="$(arg y_turn_pause_sec)" />
    <param name="y_detect_min_id" value="$(arg y_detect_min_id)" />
    <param name="y_center_aim_dist" value="$(arg y_center_aim_dist)" />
    <param name="y_approach_speed" value="$(arg y_approach_speed)" />
    <param name="y_center_max_wz" value="$(arg y_center_max_wz)" />
    <param name="y_lost_confirm_frames" value="$(arg y_lost_confirm_frames)" />
    <param name="y_entry_min_odom" value="$(arg y_entry_min_odom)" />
    <param name="y_entry_max_odom" value="$(arg y_entry_max_odom)" />
    <param name="y_detect_max_id" value="$(arg y_detect_max_id)" />
    <param name="y_detect_confirm_frames" value="$(arg y_detect_confirm_frames)" />
    <param name="y_crossbar_seek_speed" value="$(arg y_crossbar_seek_speed)" />
    <param name="y_crossbar_lost_confirm_frames" value="$(arg y_crossbar_lost_confirm_frames)" />
    <param name="y_crossbar_target_long_m" value="$(arg y_crossbar_target_long_m)" />
    <param name="y_crossbar_long_tolerance_m" value="$(arg y_crossbar_long_tolerance_m)" />
    <param name="y_crossbar_max_abs_lat_m" value="$(arg y_crossbar_max_abs_lat_m)" />
    <param name="y_crossbar_confirm_frames" value="$(arg y_crossbar_confirm_frames)" />
    <param name="y_crossbar_seek_max_odom" value="$(arg y_crossbar_seek_max_odom)" />
    <param name="control_path_smooth_window" value="$(arg control_path_smooth_window)" />
    <param name="control_path_ema_alpha" value="$(arg control_path_ema_alpha)" />
    <param name="control_error_filter_alpha" value="$(arg control_error_filter_alpha)" />
    <param name="control_yaw_deadband" value="$(arg control_yaw_deadband)" />
    <param name="control_kp_yaw" value="$(arg control_kp_yaw)" />
    <param name="control_ki_yaw" value="$(arg control_ki_yaw)" />
    <param name="control_kd_yaw" value="$(arg control_kd_yaw)" />
    <param name="control_integral_limit" value="$(arg control_integral_limit)" />
    <param name="control_integral_error_threshold" value="$(arg control_integral_error_threshold)" />
    <param name="control_adaptive_error_threshold" value="$(arg control_adaptive_error_threshold)" />
    <param name="control_adaptive_kp_scale" value="$(arg control_adaptive_kp_scale)" />
    <param name="control_adaptive_kd_scale" value="$(arg control_adaptive_kd_scale)" />
    <param name="control_max_wz" value="$(arg control_max_wz)" />
    <param name="control_soft_wz_limit" value="$(arg control_soft_wz_limit)" />
    <param name="control_max_wz_rate" value="$(arg control_max_wz_rate)" />
    <param name="control_turn_slowdown" value="$(arg control_turn_slowdown)" />
    <param name="control_slow_error" value="$(arg control_slow_error)" />
    <param name="control_min_speed" value="$(arg control_min_speed)" />
    <param name="control_degraded_speed_scale" value="$(arg control_degraded_speed_scale)" />
    <param name="control_max_accel" value="$(arg control_max_accel)" />
    <param name="control_max_decel" value="$(arg control_max_decel)" />
    <param name="control_cmd_filter_alpha" value="$(arg control_cmd_filter_alpha)" />
    <param name="lost_line_coast_sec" value="$(arg lost_line_coast_sec)" />
    <param name="lost_line_coast_speed_scale" value="$(arg lost_line_coast_speed_scale)" />
    <param name="lost_corner_search_enabled" value="$(arg lost_corner_search_enabled)" />
    <param name="lost_corner_search_timeout" value="$(arg lost_corner_search_timeout)" />
    <param name="lost_corner_search_angular_speed" value="$(arg lost_corner_search_angular_speed)" />
    <param name="lost_corner_search_linear_speed" value="$(arg lost_corner_search_linear_speed)" />
  </node>
</launch>
