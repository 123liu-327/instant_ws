<launch>
  <arg name="image_topic" default="/ucar_camera/image_raw" />
  <arg name="odom_topic" default="/odom" />
  <arg name="cmd_vel_topic" default="/cmd_vel" />
  <arg name="status_topic" default="/factory/stop_line_parking_status" />
  <arg name="timeout_s" default="28.0" />
  <arg name="crossing_speed_mps" default="0.065" />
  <arg name="lateral_sign" default="-1.0" />
  <arg name="angle_sign" default="-1.0" />

  <node pkg="iden_controller" type="xunfei2026_stop_line_parking_v1.py"
        name="xunfei2026_stop_line_parking" output="screen" required="false">
    <param name="image_topic" value="$(arg image_topic)" />
    <param name="odom_topic" value="$(arg odom_topic)" />
    <param name="cmd_vel_topic" value="$(arg cmd_vel_topic)" />
    <param name="status_topic" value="$(arg status_topic)" />
    <param name="timeout_s" value="$(arg timeout_s)" />
    <!-- First centre on the complete transverse line; then move straight
         ahead and stop only after that previously confirmed line disappears. -->
    <param name="center_tolerance_m" value="0.030" />
    <param name="angle_tolerance_deg" value="3.5" />
    <param name="center_confirm_frames" value="4" />
    <param name="disappear_confirm_frames" value="4" />
    <param name="crossing_speed_mps" value="$(arg crossing_speed_mps)" />
    <param name="crossing_near_distance_m" value="0.105" />
    <param name="crossing_min_distance_m" value="0.025" />
    <param name="crossing_max_distance_m" value="0.42" />
    <param name="line_switch_reject_m" value="0.10" />
    <param name="max_lateral_speed_mps" value="0.055" />
    <param name="max_angular_speed_rps" value="0.18" />
    <param name="lateral_sign" value="$(arg lateral_sign)" />
    <param name="angle_sign" value="$(arg angle_sign)" />
    <param name="line_lost_timeout_s" value="0.65" />
    <!-- If the line is not yet in view, search only 18 cm before failing safe. -->
    <param name="search_speed_mps" value="0.035" />
    <param name="search_delay_s" value="1.0" />
    <param name="max_search_distance_m" value="0.18" />
    <!-- Wide horizontal-component detector, adapted from flow_end's crossbar
         logic; it does not use the fragile legacy single-column test. -->
    <param name="white_value_min" value="155" />
    <param name="white_saturation_max" value="90" />
    <param name="local_contrast_min" value="8" />
    <param name="line_min_width_m" value="0.25" />
    <param name="line_max_width_m" value="0.74" />
    <param name="line_max_angle_deg" value="18.0" />
  </node>
</launch>
