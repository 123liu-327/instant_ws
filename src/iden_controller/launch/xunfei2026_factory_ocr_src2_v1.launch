<launch>
  <!-- Native src2 PP-OCRv4.  The explicit venv is required because RKNNLite
       2.3.2 is an aarch64 CPython 3.9 wheel on the real vehicle. -->
  <node pkg="factory_sign_ppocr_rknn_test"
        type="factory_sign_ppocr_rknn_node.py"
        name="factory_sign_ppocr_rknn_node"
        output="screen" required="true"
        launch-prefix="bash -c 'export PYTHONDONTWRITEBYTECODE=1; exec /home/ucar/venv3.9/bin/python &quot;$@&quot;' dummy">
    <rosparam command="load"
              file="$(find factory_sign_ppocr_rknn_test)/config/factory_sign_ppocr_rknn.yaml" />
    <param name="image_topic" value="/ucar_camera/image_raw" />
    <param name="flip" value="false" />
    <param name="recognition_mode" value="ppocr_rknn_system" />
    <param name="inference_rate" value="5.0" />
    <param name="target_category" value="" />
    <param name="enable_speech" value="false" />
    <param name="result_topic" value="/factory_room/src2_ocr_raw" />
  </node>

  <!-- Schema/lifecycle adapter only; image detection and recognition stay
       entirely inside the native src2 node above. -->
  <node pkg="iden_controller"
        type="xunfei2026_src2_factory_ocr_adapter_v1.py"
        name="xunfei2026_src2_factory_ocr_adapter"
        output="screen" required="true">
    <param name="raw_topic" value="/factory_room/src2_ocr_raw" />
    <param name="result_topic" value="/factory_room/ocr_result" />
    <param name="control_topic" value="/factory_room/ocr_control" />
    <param name="health_topic" value="/factory_room/ocr_health" />
    <param name="required_hits" value="2" />
    <param name="evidence_window_s" value="1.5" />
    <param name="enabled_on_start" value="false" />
  </node>
</launch>
