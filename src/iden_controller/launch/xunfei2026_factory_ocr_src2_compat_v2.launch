<launch>
  <!--
    Vehicle-compatible src2 OCR:
      RKNN 1.4 PP-OCR locator/reader + src2 RKNN 1.4 sign classifier.
    The detector supplies the physical bbox required by v1 parking; a result
    is emitted only when complete OCR text and the src2 classifier agree.
  -->
  <node pkg="iden_controller"
        type="xunfei2026_src2_factory_ocr_compat_v2.py"
        name="xunfei2026_src2_factory_ocr_compat_v2"
        output="screen" required="true">
    <param name="image_topic" value="/ucar_camera/image_raw" />
    <param name="result_topic" value="/factory_room/src2_ocr_raw" />
    <param name="control_topic" value="/factory_room/ocr_control" />
    <param name="status_topic" value="/factory_room/xunfei2026_delivery_status" />
    <param name="health_topic" value="/factory_room/src2_compat_health" />
    <param name="debug_topic" value="/factory_room/ocr_debug" />
    <param name="enabled_on_start" value="true" />
    <param name="process_rate_hz" value="4.0" />
    <param name="max_width" value="960" />
    <param name="classifier_confidence_threshold" value="0.55" />
    <param name="classifier_min_margin" value="0.18" />
    <param name="classifier_daily_logit_bias" value="0.45" />
    <param name="classifier_electronic_logit_bias" value="-0.60" />
    <param name="classifier_food_logit_bias" value="0.0" />
    <param name="publish_debug" value="true" />
  </node>

  <node pkg="iden_controller"
        type="xunfei2026_src2_factory_ocr_adapter_v1.py"
        name="xunfei2026_src2_factory_ocr_adapter"
        output="screen" required="true">
    <param name="raw_topic" value="/factory_room/src2_ocr_raw" />
    <param name="result_topic" value="/factory_room/ocr_result" />
    <param name="control_topic" value="/factory_room/ocr_control" />
    <param name="health_topic" value="/factory_room/ocr_health" />
    <param name="required_hits" value="2" />
    <param name="evidence_window_s" value="1.5" />
    <param name="enabled_on_start" value="false" />
  </node>
</launch>
