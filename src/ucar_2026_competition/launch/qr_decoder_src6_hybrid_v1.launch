<launch>
  <arg name="camera_topic" default="/usb_cam/image_raw" />
  <arg name="decode_interval" default="0.10" />
  <arg name="decode_scales" default="1.0,1.5,2.0" />
  <arg name="status_topic" default="/qr_decoder/status" />
  <arg name="fetch_retries" default="3" />
  <arg name="retry_backoff" default="0.20" />
  <node pkg="yolo" type="qr_collect_and_decode_src6_hybrid_v1.py" name="qr_collect_and_decode_src6_hybrid_v1"
        output="screen" required="true"
        args="--topic $(arg camera_topic) --pub-topic /qr_code_data --status-topic $(arg status_topic) --fetch --fetch-retries $(arg fetch_retries) --retry-backoff $(arg retry_backoff) --offline-mode off --decode-interval $(arg decode_interval) --decode-scales $(arg decode_scales)" />
</launch>
