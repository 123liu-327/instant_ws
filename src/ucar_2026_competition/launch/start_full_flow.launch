<launch>
  <arg name="debug" default="false" />
  <arg name="enable_simulation" default="false" />
  <arg name="sim_bridge_host" default="$(optenv SIM_BRIDGE_HOST)" />
  <arg name="sim_bridge_port" default="26003" />
  <arg name="traffic_pose_configured" default="true" />
  <arg name="traffic_x" default="0.2595" />
  <arg name="traffic_y" default="-3.09" />
  <arg name="traffic_yaw" default="-1.5596" />
  <arg name="task4_final_xy_goal_tolerance" default="0.04" />
  <arg name="task4_final_yaw_goal_tolerance" default="0.08" />
  <arg name="task4_post_navigation_advance_m" default="0.18" />//
  <arg name="task4_post_navigation_advance_tolerance_m" default="0.01" />
  <arg name="task4_post_navigation_advance_speed_mps" default="0.12" />
  <arg name="task4_post_navigation_advance_timeout_sec" default="6.0" />
  <arg name="task45_extra_distance_m" default="0.20" />
  <arg name="task45_extra_distance_tolerance_m" default="0.015" />
  <arg name="task45_extra_distance_speed_mps" default="0.12" />
  <arg name="task45_extra_distance_timeout_sec" default="10.0" />
  <arg name="task45_camera_image_width" default="640" />
  <arg name="task45_camera_image_height" default="480" />
  <arg name="task45_camera_pixel_format" default="YUYV" />
  <arg name="task45_camera_capture_fps" default="30" />
  <arg name="task45_camera_publish_rate" default="15" />
  <arg name="task45_camera_ros_encoding" default="rgb8" />
  <arg name="parking_normal_offset" default="0.0" />
  <arg name="parking_tangent_offset" default="0.03" />
  <arg name="parking_goal_offset" default="0.26" />
  <arg name="parking_staging_offset" default="0.55" />
  <arg name="parking_staging_timeout_sec" default="20.0" />
  <arg name="parking_staging_position_tolerance" default="0.10" />
  <arg name="parking_staging_yaw_tolerance" default="0.10" />
  <arg name="parking_docking_timeout_sec" default="20.0" />
  <arg name="parking_dock_max_x" default="0.10" />
  <arg name="parking_dock_max_y" default="0.06" />
  <arg name="parking_dock_max_yaw" default="0.15" />
  <arg name="parking_dock_min_yaw" default="0.04" />
  <arg name="parking_dock_normal_tolerance" default="0.02" />
  <arg name="parking_dock_tangent_tolerance" default="0.02" />
  <arg name="parking_dock_yaw_tolerance" default="0.06" />
  <arg name="parking_dock_translation_yaw_gate" default="0.22" />
  <arg name="parking_dock_forward_yaw_gate" default="0.14" />
  <arg name="parking_dock_forward_tangent_gate" default="0.12" />
  <arg name="parking_min_wall_distance" default="0.19" />
  <arg name="parking_lidar_stop_distance" default="0.15" />
  <arg name="parking_recenter_tolerance" default="0.04" />
  <arg name="parking_recenter_timeout_sec" default="8.0" />
  <arg name="parking_recenter_initial_wait_sec" default="1.0" />
  <arg name="parking_recenter_lateral_kp" default="0.16" />
  <arg name="parking_recenter_lateral_sign" default="1.0" />
  <arg name="parking_recenter_min_lateral" default="0.015" />
  <arg name="parking_recenter_max_lateral" default="0.065" />
  <arg name="parking_recenter_max_travel" default="0.30" />
  <arg name="parking_recenter_yaw_kp" default="1.0" />
  <arg name="parking_recenter_yaw_tolerance_deg" default="2.0" />
  <arg name="parking_recenter_max_yaw" default="0.18" />
  <arg name="parking_recenter_stable_sec" default="0.25" />
  <arg name="parking_recenter_required_hits" default="3" />
  <arg name="parking_recenter_side_half_angle_deg" default="25.0" />
  <arg name="parking_recenter_side_stop_m" default="0.18" />
  <arg name="parking_recenter_side_slow_m" default="0.28" />
  <arg name="coverage_goal_soft_timeout_sec" default="7.0" />
  <arg name="coverage_goal_hard_timeout_sec" default="10.0" />
  <arg name="coverage_goal_progress_window_sec" default="5.0" />
  <arg name="coverage_goal_min_progress" default="0.03" />
  <arg name="parking_wall_fit_half_angle_deg" default="35.0" />
  <arg name="parking_wall_fit_min_points" default="12" />
  <arg name="parking_wall_fit_min_span" default="0.25" />
  <arg name="parking_wall_fit_near_min_span" default="0.18" />
  <arg name="parking_wall_fit_max_distance_jump" default="0.05" />
  <arg name="parking_wall_fit_max_normal_jump_deg" default="8.0" />
  <arg name="parking_wall_fit_max_residual" default="0.015" />
  <arg name="parking_wall_fit_max_normal_error_deg" default="20.0" />
  <arg name="parking_wall_fit_grace_sec" default="1.5" />
  <arg name="parking_wall_fit_filter_alpha" default="0.45" />
  <arg name="trigger_ack_timeout_sec" default="2.0" />
  <arg name="stage_exclusive_resources" default="true" />
  <arg name="task2_prewarm_enabled" default="true" />
  <arg name="second_parking_prewarm_enabled" default="true" />

  <!-- src3 navigation/camera/speech orchestration, without its ASR/TTS/LLM. -->
  <include file="$(find ucar_2026_competition)/launch/common_core.launch">
    <arg name="start_nav" value="true" />
    <arg name="start_camera" value="false" />
    <arg name="start_speech" value="true" />
    <arg name="start_asr" value="false" />
    <arg name="start_tts" value="false" />
    <arg name="start_llm" value="false" />
    <arg name="start_rviz" value="$(arg debug)" />
  </include>

  <!-- Existing speech_command hardware/credentials remain authoritative. -->
  <node pkg="ucar_2026_competition" type="src3_complete_sentence_cloud_asr_exec_v1.sh"
        name="cloud_asr_test2" output="log">
    <param name="tts_topic" value="/factory/tts_text" />
    <param name="command_accepted_topic" value="/factory/voice_command_accepted" />
    <param name="close_after_command_accepted" value="true" />
  </node>
  <node pkg="ucar_2026_competition"
        type="src3_legacy_voice_bridge_complete_sentence_v1.py"
        name="src3_legacy_voice_bridge" output="screen" required="false">
    <param name="fragment_reset_s" value="8.0" />
  </node>

  <!-- Camera, Spark, OCR and room navigation start only in consuming stages. -->
  <include file="$(find ucar_2026_competition)/launch/flow_node_current_front_39ff_room_v1.launch">
    <arg name="start_stage" value="full" />
    <arg name="debug" value="$(arg debug)" />
    <arg name="enable_simulation" value="$(arg enable_simulation)" />
    <arg name="sim_bridge_host" value="$(arg sim_bridge_host)" />
    <arg name="sim_bridge_port" value="$(arg sim_bridge_port)" />
    <arg name="traffic_pose_configured" value="$(arg traffic_pose_configured)" />
    <arg name="traffic_x" value="$(arg traffic_x)" />
    <arg name="traffic_y" value="$(arg traffic_y)" />
    <arg name="traffic_yaw" value="$(arg traffic_yaw)" />
    <arg name="task4_final_xy_goal_tolerance" value="$(arg task4_final_xy_goal_tolerance)" />
    <arg name="task4_final_yaw_goal_tolerance" value="$(arg task4_final_yaw_goal_tolerance)" />
    <arg name="task4_post_navigation_advance_m" value="$(arg task4_post_navigation_advance_m)" />
    <arg name="task4_post_navigation_advance_tolerance_m" value="$(arg task4_post_navigation_advance_tolerance_m)" />
    <arg name="task4_post_navigation_advance_speed_mps" value="$(arg task4_post_navigation_advance_speed_mps)" />
    <arg name="task4_post_navigation_advance_timeout_sec" value="$(arg task4_post_navigation_advance_timeout_sec)" />
    <arg name="task45_extra_distance_m" value="$(arg task45_extra_distance_m)" />
    <arg name="task45_extra_distance_tolerance_m" value="$(arg task45_extra_distance_tolerance_m)" />
    <arg name="task45_extra_distance_speed_mps" value="$(arg task45_extra_distance_speed_mps)" />
    <arg name="task45_extra_distance_timeout_sec" value="$(arg task45_extra_distance_timeout_sec)" />
    <arg name="task45_camera_image_width" value="$(arg task45_camera_image_width)" />
    <arg name="task45_camera_image_height" value="$(arg task45_camera_image_height)" />
    <arg name="task45_camera_pixel_format" value="$(arg task45_camera_pixel_format)" />
    <arg name="task45_camera_capture_fps" value="$(arg task45_camera_capture_fps)" />
    <arg name="task45_camera_publish_rate" value="$(arg task45_camera_publish_rate)" />
    <arg name="task45_camera_ros_encoding" value="$(arg task45_camera_ros_encoding)" />
    <arg name="parking_normal_offset" value="$(arg parking_normal_offset)" />
    <arg name="parking_tangent_offset" value="$(arg parking_tangent_offset)" />
    <arg name="parking_goal_offset" value="$(arg parking_goal_offset)" />
    <arg name="parking_staging_offset" value="$(arg parking_staging_offset)" />
    <arg name="parking_staging_timeout_sec" value="$(arg parking_staging_timeout_sec)" />
    <arg name="parking_staging_position_tolerance" value="$(arg parking_staging_position_tolerance)" />
    <arg name="parking_staging_yaw_tolerance" value="$(arg parking_staging_yaw_tolerance)" />
    <arg name="parking_docking_timeout_sec" value="$(arg parking_docking_timeout_sec)" />
    <arg name="parking_dock_max_x" value="$(arg parking_dock_max_x)" />
    <arg name="parking_dock_max_y" value="$(arg parking_dock_max_y)" />
    <arg name="parking_dock_max_yaw" value="$(arg parking_dock_max_yaw)" />
    <arg name="parking_dock_min_yaw" value="$(arg parking_dock_min_yaw)" />
    <arg name="parking_dock_normal_tolerance" value="$(arg parking_dock_normal_tolerance)" />
    <arg name="parking_dock_tangent_tolerance" value="$(arg parking_dock_tangent_tolerance)" />
    <arg name="parking_dock_yaw_tolerance" value="$(arg parking_dock_yaw_tolerance)" />
    <arg name="parking_dock_translation_yaw_gate" value="$(arg parking_dock_translation_yaw_gate)" />
    <arg name="parking_dock_forward_yaw_gate" value="$(arg parking_dock_forward_yaw_gate)" />
    <arg name="parking_dock_forward_tangent_gate" value="$(arg parking_dock_forward_tangent_gate)" />
    <arg name="parking_min_wall_distance" value="$(arg parking_min_wall_distance)" />
    <arg name="parking_lidar_stop_distance" value="$(arg parking_lidar_stop_distance)" />
    <arg name="parking_recenter_tolerance" value="$(arg parking_recenter_tolerance)" />
    <arg name="parking_recenter_timeout_sec" value="$(arg parking_recenter_timeout_sec)" />
    <arg name="parking_recenter_initial_wait_sec" value="$(arg parking_recenter_initial_wait_sec)" />
    <arg name="parking_recenter_lateral_kp" value="$(arg parking_recenter_lateral_kp)" />
    <arg name="parking_recenter_lateral_sign" value="$(arg parking_recenter_lateral_sign)" />
    <arg name="parking_recenter_min_lateral" value="$(arg parking_recenter_min_lateral)" />
    <arg name="parking_recenter_max_lateral" value="$(arg parking_recenter_max_lateral)" />
    <arg name="parking_recenter_max_travel" value="$(arg parking_recenter_max_travel)" />
    <arg name="parking_recenter_yaw_kp" value="$(arg parking_recenter_yaw_kp)" />
    <arg name="parking_recenter_yaw_tolerance_deg" value="$(arg parking_recenter_yaw_tolerance_deg)" />
    <arg name="parking_recenter_max_yaw" value="$(arg parking_recenter_max_yaw)" />
    <arg name="parking_recenter_stable_sec" value="$(arg parking_recenter_stable_sec)" />
    <arg name="parking_recenter_required_hits" value="$(arg parking_recenter_required_hits)" />
    <arg name="parking_recenter_side_half_angle_deg" value="$(arg parking_recenter_side_half_angle_deg)" />
    <arg name="parking_recenter_side_stop_m" value="$(arg parking_recenter_side_stop_m)" />
    <arg name="parking_recenter_side_slow_m" value="$(arg parking_recenter_side_slow_m)" />
    <arg name="coverage_goal_soft_timeout_sec" value="$(arg coverage_goal_soft_timeout_sec)" />
    <arg name="coverage_goal_hard_timeout_sec" value="$(arg coverage_goal_hard_timeout_sec)" />
    <arg name="coverage_goal_progress_window_sec" value="$(arg coverage_goal_progress_window_sec)" />
    <arg name="coverage_goal_min_progress" value="$(arg coverage_goal_min_progress)" />
    <arg name="parking_wall_fit_half_angle_deg" value="$(arg parking_wall_fit_half_angle_deg)" />
    <arg name="parking_wall_fit_min_points" value="$(arg parking_wall_fit_min_points)" />
    <arg name="parking_wall_fit_min_span" value="$(arg parking_wall_fit_min_span)" />
    <arg name="parking_wall_fit_near_min_span" value="$(arg parking_wall_fit_near_min_span)" />
    <arg name="parking_wall_fit_max_distance_jump" value="$(arg parking_wall_fit_max_distance_jump)" />
    <arg name="parking_wall_fit_max_normal_jump_deg" value="$(arg parking_wall_fit_max_normal_jump_deg)" />
    <arg name="parking_wall_fit_max_residual" value="$(arg parking_wall_fit_max_residual)" />
    <arg name="parking_wall_fit_max_normal_error_deg" value="$(arg parking_wall_fit_max_normal_error_deg)" />
    <arg name="parking_wall_fit_grace_sec" value="$(arg parking_wall_fit_grace_sec)" />
    <arg name="parking_wall_fit_filter_alpha" value="$(arg parking_wall_fit_filter_alpha)" />
    <arg name="trigger_ack_timeout_sec" value="$(arg trigger_ack_timeout_sec)" />
    <arg name="stage_exclusive_resources" value="$(arg stage_exclusive_resources)" />
    <arg name="task2_prewarm_enabled" value="$(arg task2_prewarm_enabled)" />
    <arg name="second_parking_prewarm_enabled" value="$(arg second_parking_prewarm_enabled)" />
  </include>
</launch>
